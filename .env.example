# === FUNSTAT CLONE - CREDENTIALS ===
# Yaha apne credentials bharo, ye file ko .env me rename kardo

# 1. @BotFather se milega
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxx

# 2. my.telegram.org -> API Development Tools se milega
API_ID=123456
API_HASH=abcd1234efgh5678ijkl9012mnop3456

# 3. @userinfobot se apni ID nikalo (Owner ID)
OWNER_ID=123456789
ADMIN_IDS=123456789,987654321

# 4. Database
DATABASE_PATH=database/funstat.db

# 5. Payment - Owner yaha se default set kar sakta hai, baad me bot se bhi change hoga
DEFAULT_PRICE_PER_CREDIT=20
DEFAULT_UPI_ID=yourname@upi
DEFAULT_USDT_TRC20=TXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_USDT_BEP20=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 6. Web Admin Panel
WEB_ADMIN_PORT=5000
WEB_ADMIN_SECRET=change_this_secret_key_123

# 6. Anti-Sleep (Paste your Render URL here, bot will self-ping every 5 min to never sleep)
SLEEP_MODE=0
RENDER_URL=https://your-bot-name.onrender.com
KEEP_ALIVE_INTERVAL=300
